// Windows resources for Parley.exe (icons + version info).
// Rebuild rsrc_windows_amd64.syso after changing: see docs/BUILDING.md.
1 ICON "../assets/logo/parley.ico"
2 ICON "../assets/logo/parley-bubbles.ico"

1 VERSIONINFO
FILEVERSION 1,9,3,0
PRODUCTVERSION 1,9,3,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Magichouse Media"
      VALUE "FileDescription", "Parley - WoW chat translator"
      VALUE "FileVersion", "1.9.3"
      VALUE "InternalName", "Parley"
      VALUE "LegalCopyright", "(c) 2026 Magichouse Media. MIT License."
      VALUE "OriginalFilename", "Parley.exe"
      VALUE "ProductName", "Parley"
      VALUE "ProductVersion", "1.9.3"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
