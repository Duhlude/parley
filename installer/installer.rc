// Windows resources for Parley.exe (icons + version info).
// Rebuild rsrc_windows_amd64.syso after changing: see docs/BUILDING.md.
1 ICON "../assets/logo/parley.ico"

1 VERSIONINFO
FILEVERSION 1,6,0,0
PRODUCTVERSION 1,6,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Magichouse Media"
      VALUE "FileDescription", "Parley Setup"
      VALUE "FileVersion", "1.6.0"
      VALUE "InternalName", "Parley-Setup"
      VALUE "LegalCopyright", "(c) 2026 Magichouse Media. MIT License."
      VALUE "OriginalFilename", "Parley-Setup.exe"
      VALUE "ProductName", "Parley"
      VALUE "ProductVersion", "1.6.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
